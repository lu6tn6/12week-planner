# 資料庫
DATABASE_URL=postgresql://user:password@localhost:5432/12week_planner

# Google OAuth
GOOGLE_CLIENT_ID=你的_Google_Client_ID
GOOGLE_CLIENT_SECRET=你的_Google_Client_Secret
GOOGLE_CALLBACK_URL=https://你的網域/auth/google/callback

# JWT
JWT_SECRET=請換成一個很長的隨機字串

# Session
SESSION_SECRET=請換成另一個很長的隨機字串

# 管理員 Email（第一個用這個 Email 登入的人自動成為管理員）
ADMIN_EMAIL=lu6tn6@gmail.com

# 前端網址（CORS 用）
FRONTEND_URL=https://你的前端網域

# 環境
NODE_ENV=production
PORT=3000
